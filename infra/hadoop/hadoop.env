# Configuration HDFS (images bde2020/hadoop-*). Aucun secret ici.
# Convention de ces images : CORE_CONF_* -> core-site.xml, HDFS_CONF_* -> hdfs-site.xml
# ("." devient "_", "-" devient "___", "_" devient "__").

# Adresse du NameNode utilisée par tous les clients (DataNodes, Spark, hdfs-init)
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root

# Réplication 2 : exigé par la fiche (2 DataNodes). Chaque bloc existe en 2 copies.
HDFS_CONF_dfs_replication=2

# Projet pédagogique : pas de gestion des droits par utilisateur
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_webhdfs_enabled=true

# Nécessaire avec Docker : les DataNodes s'enregistrent par IP de conteneur
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false
